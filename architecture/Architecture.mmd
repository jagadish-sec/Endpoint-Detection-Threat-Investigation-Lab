%%======================
%% Classes
%%======================

classDef internet fill:#6f42c1,stroke:#c297ff,stroke-width:3px,color:#ffffff;

classDef external fill:#2d3748,stroke:#7dd3fc,stroke-width:2px,color:#ffffff;

classDef attacker fill:#7f1d1d,stroke:#ff6b6b,stroke-width:3px,color:#ffffff;

classDef network fill:#78350f,stroke:#fbbf24,stroke-width:3px,color:#ffffff;

classDef monitor fill:#0c4a6e,stroke:#38bdf8,stroke-width:2px,color:#ffffff;

classDef log fill:#164e63,stroke:#67e8f9,stroke-width:2px,color:#ffffff;

classDef agent fill:#155e75,stroke:#22d3ee,stroke-width:3px,color:#ffffff;

classDef siem fill:#14532d,stroke:#4ade80,stroke-width:3px,color:#ffffff;

classDef analysis fill:#166534,stroke:#86efac,stroke-width:2px,color:#ffffff;

classDef title fill:transparent,stroke:transparent,color:#8bd5ff,font-size:20px,font-weight:bold;

classDef invisible fill:transparent,stroke:transparent,color:transparent;

%%======================
%% Cluster Styling
%%======================

style EM fill:#111827,stroke:#38bdf8,stroke-width:2px,stroke-dasharray:8 5

style SA fill:#111827,stroke:#4ade80,stroke-width:2px,stroke-dasharray:8 5

%%======================
%% Arrow Styling
%%======================

linkStyle default stroke:#00E5FF,stroke-width:3px
